{
  "name": "recreation-planner",
  "version": "1.4.5",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "bump": "changeset version",
    "clean:localstorage": "rm -f vite-storage*",
    "dev": "next dev --turbopack",
    "lint": "eslint .",
    "prepare": "husky",
    "start": "next start",
    "test": "bash -c 'vitest run ${@:2}; code=$?; pnpm clean:localstorage; exit \"$code\"' bash",
    "test:dev": "sh -c 'vitest; code=$?; pnpm clean:localstorage; exit \"$code\"'"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/speed-insights": "^2.0.0",
    "daisyui": "^5.7.50",
    "date-fns": "^4.4.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@ionic/prettier-config": "^4.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "npm:types-react@19.0.0-rc.1",
    "@types/react-dom": "npm:types-react-dom@19.0.0-rc.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "prettier": "@ionic/prettier-config",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,md,json}": [
      "prettier --write",
      "eslint"
    ]
  },
  "packageManager": "pnpm@12.14.0"
}
